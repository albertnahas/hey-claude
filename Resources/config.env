# Hey Claude session settings (shell syntax). Changes apply on the next wake.
# The wake phrases are set in the app: menu-bar icon → Settings.

# Folder Claude Code starts in. Claude Code asks you to trust it on the first wake.
WORKDIR="$HOME/.hey-claude"

# Extra flags passed to `claude`, e.g. "--model opus".
CLAUDE_ARGS=""

# First message, sent immediately. {screenshots} becomes the image path(s).
PROMPT="Here is a screenshot of my desktop right now: {screenshots}
Look at it and briefly tell me what you see, then wait for my question."

# Where the session opens: auto (the terminal you already use), or one of
# cmux, iterm, ghostty, wezterm, kitty, alacritty, terminal. Falls back to the others if it fails.
TERMINAL_APP=auto

# Screenshots and session launchers older than this many days are deleted.
KEEP_SCREENSHOTS_DAYS=7
