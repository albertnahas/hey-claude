# Hey Claude configuration (shell syntax). Changes apply on the next wake;
# WAKE_PATTERN is picked up within a minute.

# Regex matched, case-insensitively, against what the Mac hears.
# Includes common mishearings of "Claude".
WAKE_PATTERN='\b(hey|hello)\W+(claude|claud|clawed|cloud|clyde)\b'

# Folder Claude Code starts in. Pick one you have already trusted in Claude Code,
# or the session opens on the trust prompt.
WORKDIR="$HOME"

# Extra flags passed to `claude`, e.g. "--model opus".
CLAUDE_ARGS=""

# First message, sent immediately. {screenshots} becomes the image path(s).
PROMPT="Here is a screenshot of my desktop right now: {screenshots}
Look at it and briefly tell me what you see, then wait for my question."

# Where the session opens: terminal, iterm, or cmux.
TERMINAL_APP=terminal

# Screenshots older than this many days are deleted.
KEEP_SCREENSHOTS_DAYS=7
